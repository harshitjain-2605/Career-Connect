<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.campus.placement.controller.AdminDrivesController">
    <left>
        <VBox styleClass="sidebar" spacing="6">
            <Label text="TPO / Admin Portal" styleClass="sidebar-brand"/>
            <Button text="Dashboard" onAction="#navDashboard" styleClass="sidebar-btn"/>
            <Button text="Companies" onAction="#navCompanies" styleClass="sidebar-btn"/>
            <Button text="Placement Drives" onAction="#navDrives" styleClass="sidebar-btn-active"/>
            <Button text="Applicant Pipeline" onAction="#navApplicants" styleClass="sidebar-btn"/>
            <Button text="Manage Students" onAction="#navStudents" styleClass="sidebar-btn"/>
            <Button text="Reports &amp; Audit" onAction="#navReports" styleClass="sidebar-btn"/>
            <Button text="Placement Policy" onAction="#navPolicy" styleClass="sidebar-btn"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="btn-danger" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Manage Placement Drives" styleClass="page-title"/>

            <HBox spacing="14" VBox.vgrow="ALWAYS">
                <TableView fx:id="drivesTable" HBox.hgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCompany" text="Company" prefWidth="150"/>
                        <TableColumn fx:id="colRole" text="Role" prefWidth="150"/>
                        <TableColumn fx:id="colPkg" text="LPA" prefWidth="65"/>
                        <TableColumn fx:id="colMinCgpa" text="Min CGPA" prefWidth="75"/>
                        <TableColumn fx:id="colBranches" text="Branches" prefWidth="140"/>
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="90"/>
                    </columns>
                </TableView>

                <ScrollPane fitToWidth="true" prefWidth="350">
                    <VBox styleClass="card" spacing="8">
                        <Label text="Drive &amp; Eligibility" styleClass="section-title"/>
                        <ComboBox fx:id="companyCombo" promptText="Select Company *" maxWidth="Infinity"/>
                        <TextField fx:id="roleField" promptText="Job Role *"/>
                        <HBox spacing="8">
                            <TextField fx:id="packageField" promptText="Package LPA *" HBox.hgrow="ALWAYS"/>
                            <TextField fx:id="locationField" promptText="Location *" HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <HBox spacing="8">
                            <ComboBox fx:id="jobTypeCombo" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                            <ComboBox fx:id="statusCombo" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <HBox spacing="8">
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label text="Last Date *" style="-fx-font-size: 11px;"/>
                                <DatePicker fx:id="lastDatePicker" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label text="Drive Date *" style="-fx-font-size: 11px;"/>
                                <DatePicker fx:id="driveDatePicker" maxWidth="Infinity"/>
                            </VBox>
                        </HBox>
                        <HBox spacing="8">
                            <TextField fx:id="minCgpaField" promptText="Min CGPA *" HBox.hgrow="ALWAYS"/>
                            <TextField fx:id="maxBacklogsField" promptText="Max Backlogs *" HBox.hgrow="ALWAYS"/>
                            <TextField fx:id="batchField" text="2026" promptText="Batch" HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <Label text="Allowed Branches *"/>
                        <HBox spacing="10">
                            <CheckBox fx:id="chkCse" text="CSE" selected="true"/>
                            <CheckBox fx:id="chkEce" text="ECE" selected="true"/>
                            <CheckBox fx:id="chkMe" text="ME"/>
                            <CheckBox fx:id="chkEe" text="EE"/>
                            <CheckBox fx:id="chkChe" text="CHE"/>
                        </HBox>
                        <TextArea fx:id="descArea" prefRowCount="2" promptText="Description"/>
                        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>
                        <HBox spacing="8">
                            <Button text="Add" onAction="#handleAdd" styleClass="btn-success" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button text="Update" onAction="#handleUpdate" styleClass="btn-primary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        </HBox>
                        <HBox spacing="8">
                            <Button text="Clear" onAction="#handleClear" styleClass="btn-secondary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button text="Delete" onAction="#handleDelete" styleClass="btn-danger" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        </HBox>
                    </VBox>
                </ScrollPane>
            </HBox>
        </VBox>
    </center>
</BorderPane>
