<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.campus.placement.controller.LoginController">
    <top>
        <HBox styleClass="app-header" alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="2">
                <Label text="Campus Placement Management System" styleClass="app-title"/>
                <Label text="UCS553 Enterprise Web Application • Core Java, JDBC &amp; JavaFX" styleClass="app-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Policy &amp; Architecture" onAction="#handleAbout" styleClass="btn-secondary"/>
        </HBox>
    </top>

    <center>
        <StackPane>
            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>
            <VBox styleClass="card" spacing="14" maxWidth="420" maxHeight="440">
                <Label text="Sign In" styleClass="page-title"/>
                <Label text="Enter your campus email and password" style="-fx-text-fill: #64748b;"/>

                <VBox spacing="4">
                    <Label text="Email"/>
                    <TextField fx:id="emailField" promptText="e.g. aarav.sharma@campus.edu"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Password"/>
                    <PasswordField fx:id="passwordField" promptText="Enter password" onAction="#handleLogin"/>
                </VBox>

                <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>

                <Button fx:id="loginButton" text="Login" onAction="#handleLogin"
                        defaultButton="true" styleClass="btn-primary" maxWidth="Infinity"/>

                <HBox alignment="CENTER" spacing="8">
                    <Label text="New student?"/>
                    <Button text="Register Here" onAction="#handleGoToRegister" styleClass="btn-secondary"/>
                </HBox>

                <Separator/>
                <Label text="Demo: admin@campus.edu / Admin@123 | aarav.sharma@campus.edu / Student@123"
                       wrapText="true" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
