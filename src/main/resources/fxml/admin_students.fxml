<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.campus.placement.controller.AdminStudentsController">
    <left>
        <VBox styleClass="sidebar" spacing="6">
            <Label text="TPO / Admin Portal" styleClass="sidebar-brand"/>
            <Button text="Dashboard" onAction="#navDashboard" styleClass="sidebar-btn"/>
            <Button text="Companies" onAction="#navCompanies" styleClass="sidebar-btn"/>
            <Button text="Placement Drives" onAction="#navDrives" styleClass="sidebar-btn"/>
            <Button text="Applicant Pipeline" onAction="#navApplicants" styleClass="sidebar-btn"/>
            <Button text="Manage Students" onAction="#navStudents" styleClass="sidebar-btn-active"/>
            <Button text="Reports &amp; Audit" onAction="#navReports" styleClass="sidebar-btn"/>
            <Button text="Placement Policy" onAction="#navPolicy" styleClass="sidebar-btn"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="btn-danger" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Manage Students" styleClass="page-title"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Search name, roll no, skills..." HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="branchFilterCombo" prefWidth="100"/>
                <TextField fx:id="minCgpaField" promptText="Min CGPA" prefWidth="90"/>
                <ComboBox fx:id="sortCombo" prefWidth="130"/>
                <Button text="Filter" onAction="#loadStudents" styleClass="btn-primary"/>
            </HBox>

            <HBox spacing="14" VBox.vgrow="ALWAYS">
                <TableView fx:id="studentsTable" HBox.hgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colRoll" text="Roll No" prefWidth="95"/>
                        <TableColumn fx:id="colName" text="Name" prefWidth="160"/>
                        <TableColumn fx:id="colBranch" text="Branch" prefWidth="65"/>
                        <TableColumn fx:id="colCgpa" text="CGPA" prefWidth="65"/>
                        <TableColumn fx:id="colBacklogs" text="Backlogs" prefWidth="70"/>
                        <TableColumn fx:id="colBlocked" text="Blocked" prefWidth="75"/>
                    </columns>
                </TableView>

                <VBox styleClass="card" spacing="8" prefWidth="290">
                    <Label text="Edit Student" styleClass="section-title"/>
                    <TextField fx:id="editNameField" promptText="Full Name"/>
                    <TextField fx:id="editPhoneField" promptText="Phone"/>
                    <HBox spacing="8">
                        <ComboBox fx:id="editBranchCombo" prefWidth="100"/>
                        <TextField fx:id="editCgpaField" promptText="CGPA" HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="editBacklogsField" promptText="Backlogs" prefWidth="75"/>
                    </HBox>
                    <TextArea fx:id="editSkillsArea" prefRowCount="2" promptText="Skills"/>
                    <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>
                    <Button text="Save Changes" onAction="#handleSave" styleClass="btn-primary" maxWidth="Infinity"/>
                    <Button text="Toggle Block / Unblock" onAction="#handleToggleBlock" styleClass="btn-secondary" maxWidth="Infinity"/>
                    <Button text="Delete Student" onAction="#handleDelete" styleClass="btn-danger" maxWidth="Infinity"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
