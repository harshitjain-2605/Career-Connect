<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.campus.placement.controller.AdminCompaniesController">
    <left>
        <VBox styleClass="sidebar" spacing="6">
            <Label text="TPO / Admin Portal" styleClass="sidebar-brand"/>
            <Button text="Dashboard" onAction="#navDashboard" styleClass="sidebar-btn"/>
            <Button text="Companies" onAction="#navCompanies" styleClass="sidebar-btn-active"/>
            <Button text="Placement Drives" onAction="#navDrives" styleClass="sidebar-btn"/>
            <Button text="Applicant Pipeline" onAction="#navApplicants" styleClass="sidebar-btn"/>
            <Button text="Manage Students" onAction="#navStudents" styleClass="sidebar-btn"/>
            <Button text="Reports &amp; Audit" onAction="#navReports" styleClass="sidebar-btn"/>
            <Button text="Placement Policy" onAction="#navPolicy" styleClass="sidebar-btn"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="btn-danger" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="14">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <Label text="Manage Companies" styleClass="page-title"/>

            <HBox spacing="10">
                <TextField fx:id="searchField" promptText="Search company, industry, contact..." HBox.hgrow="ALWAYS"/>
                <Button text="Search" onAction="#loadCompanies" styleClass="btn-primary"/>
            </HBox>

            <HBox spacing="16" VBox.vgrow="ALWAYS">
                <TableView fx:id="companiesTable" HBox.hgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colName" text="Name" prefWidth="170"/>
                        <TableColumn fx:id="colIndustry" text="Industry" prefWidth="140"/>
                        <TableColumn fx:id="colContact" text="Contact Person" prefWidth="130"/>
                        <TableColumn fx:id="colEmail" text="Email" prefWidth="160"/>
                        <TableColumn fx:id="colPhone" text="HR Phone" prefWidth="105"/>
                    </columns>
                </TableView>

                <VBox styleClass="card" spacing="10" prefWidth="310">
                    <Label text="Company Details" styleClass="section-title"/>
                    <TextField fx:id="nameField" promptText="Company Name *"/>
                    <TextField fx:id="industryField" promptText="Industry *"/>
                    <TextField fx:id="websiteField" promptText="Website URL"/>
                    <TextField fx:id="contactField" promptText="Contact Person *"/>
                    <TextField fx:id="emailField" promptText="Contact Email *"/>
                    <TextField fx:id="phoneField" promptText="HR Phone *"/>
                    <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>
                    <HBox spacing="8">
                        <Button text="Add" onAction="#handleAdd" styleClass="btn-success" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button text="Update" onAction="#handleUpdate" styleClass="btn-primary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                    <HBox spacing="8">
                        <Button text="Clear" onAction="#handleClear" styleClass="btn-secondary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button text="Delete" onAction="#handleDelete" styleClass="btn-danger" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
