<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.campus.placement.controller.AdminReportsController">
    <left>
        <VBox styleClass="sidebar" spacing="6">
            <Label text="TPO / Admin Portal" styleClass="sidebar-brand"/>
            <Button text="Dashboard" onAction="#navDashboard" styleClass="sidebar-btn"/>
            <Button text="Companies" onAction="#navCompanies" styleClass="sidebar-btn"/>
            <Button text="Placement Drives" onAction="#navDrives" styleClass="sidebar-btn"/>
            <Button text="Applicant Pipeline" onAction="#navApplicants" styleClass="sidebar-btn"/>
            <Button text="Manage Students" onAction="#navStudents" styleClass="sidebar-btn"/>
            <Button text="Reports &amp; Audit" onAction="#navReports" styleClass="sidebar-btn-active"/>
            <Button text="Placement Policy" onAction="#navPolicy" styleClass="sidebar-btn"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="btn-danger" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="14">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Reports, Backup &amp; Audit Log" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Export Offers CSV" onAction="#handleExportCsv" styleClass="btn-primary"/>
                <Button text="Import Students CSV" onAction="#handleImportCsv" styleClass="btn-secondary"/>
                <Button text="Printable Summary (.txt)" onAction="#handlePrintableReport" styleClass="btn-secondary"/>
                <Button text="Save Snapshot (.ser)" onAction="#handleSaveSnapshot" styleClass="btn-success"/>
                <Button text="Inspect Snapshot (.ser)" onAction="#handleInspectSnapshot" styleClass="btn-secondary"/>
            </HBox>

            <HBox spacing="14" prefHeight="190">
                <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="Placed Students by Branch" styleClass="section-title"/>
                    <ListView fx:id="branchSummaryList" VBox.vgrow="ALWAYS"/>
                </VBox>
                <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="Offers by Company" styleClass="section-title"/>
                    <ListView fx:id="companySummaryList" VBox.vgrow="ALWAYS"/>
                </VBox>
            </HBox>

            <VBox styleClass="card" spacing="8" VBox.vgrow="ALWAYS">
                <Label text="System Audit Log (Recent 100 Actions)" styleClass="section-title"/>
                <TableView fx:id="auditTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colTime" text="Timestamp" prefWidth="150"/>
                        <TableColumn fx:id="colActor" text="Actor User ID" prefWidth="95"/>
                        <TableColumn fx:id="colAction" text="Action" prefWidth="130"/>
                        <TableColumn fx:id="colEntity" text="Entity" prefWidth="110"/>
                        <TableColumn fx:id="colDetails" text="Details" prefWidth="320"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
